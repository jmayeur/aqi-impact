# Copy this file to .env and fill in your values.

# URL of your local air quality sensor HTTP API
# The sensor returns 24h of PM1/PM2.5/PM10 readings as JSON
AQI_SENSOR_URL=http://<YOUR_SENSOR_IP>/aq-data.json?$dh=24&fields=(p1,p10,p25)

# Absolute path to the SQLite database on the Raspberry Pi
# Used by score-from-sqlite.ts and backfill.ts
AQI_DB_PATH=/home/<pi-user>/<repo>/environment

# ── Cloudflare R2 (Pi uploads + Pages deployment) ────────────────────────────
# Get these from: dash.cloudflare.com → R2 → your bucket → Manage R2 API Tokens
CF_ACCOUNT_ID=<your-cloudflare-account-id>
R2_BUCKET=aqi-scores
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Public base URL for score files — empty = local dev (served from /scores/)
# Set to your R2 public domain on Cloudflare Pages:
#   https://pub-xxxxxxxxxxxx.r2.dev
PUBLIC_SCORES_BASE=
